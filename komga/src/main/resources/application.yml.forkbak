spring:
  config:
    activate:
      on: application

  datasource:
    url: jdbc:sqlite:target/db/komga.db
    driver-class-name: org.sqlite.JDBC
    username: root
    password:

  jpa:
    database-platform: org.hibernate.dialect.SoftDeleteDialect
    properties:
      hibernate:
        batch_size: 100
        dialect: org.hibernate.dialect.SoftDeleteDialect

  servlet:
    port: 8080

server:
  servlet:
    context-path: /
  tomcat:
    uri-encoding: UTF-8

logging:
  level:
    root: INFO
    org.gotson.komga: DEBUG
